{
  "name": "silicon-valley-smackdown",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "An offline arcade fighting game set in Silicon Valley",
  "author": "Sheraj Ragoobeer",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "build:desktop": "npm run typecheck && node scripts/build-desktop.mjs",
    "desktop": "npm run build:desktop && electron .",
    "dist:win": "npm run build:desktop && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run build:desktop && electron-builder --mac --publish never",
    "test:desktop:unit": "node --test tests/desktop/assets.test.cjs",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "build:portable": "npm run typecheck && node scripts/build-portable.mjs",
    "package:zip": "npm run build:portable && node scripts/package-arena.mjs",
    "test:arena": "playwright test --config playwright.arena.config.ts",
    "evidence:arena": "node scripts/arena-evidence.mjs",
    "perf:arena": "node scripts/arena-perf.mjs",
    "dev:online": "node scripts/dev-online.mjs",
    "build:server": "node scripts/build-server.mjs",
    "start:online": "node dist-server/index.js",
    "test:online": "vitest run src/arena/snapshot.test.ts src/arena/net/RollbackSession.test.ts server/rooms.test.ts shared/fingerprint.test.ts",
    "test:online:e2e": "playwright test --config playwright.online.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.186.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "three": "^0.186.0",
    "ws": "^8.18.3"
  }
}
