{
  "name": "silicon-valley-smackdown",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An offline arcade fighting game set in Silicon Valley",
  "author": "Sheraj Ragoobeer",
  "main": "desktop/main.cjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "build:desktop": "npm run typecheck && node scripts/build-desktop.mjs",
    "desktop": "npm run build:desktop && electron .",
    "dist:win": "npm run build:desktop && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run build:desktop && electron-builder --mac --publish never",
    "test:desktop:unit": "node --test tests/desktop/assets.test.cjs",
    "test:desktop": "playwright test --config playwright.desktop.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  }
}
