# Room server. One process owns every room. Restarting it ends every match.
PORT=8787
HOST=0.0.0.0
# Comma-separated browser origins. Same-host and localhost are always allowed.
ALLOWED_ORIGINS=
# How long an abandoned lobby stays open, and how long a dropped player can resume.
ROOM_TTL_MS=600000
REJOIN_GRACE_MS=10000
# Serve the game under a path prefix, for example /play
BASE_PATH=
# Set TRUST_PROXY=1 only behind a proxy that overwrites X-Forwarded-For.
# TRUST_PROXY=
# Optional build-time client settings. Do not point these at a machine that is not yours.
# VITE_MULTIPLAYER_URL=wss://your-host.example/ws
# VITE_PUBLIC_GAME_URL=https://your-host.example/
